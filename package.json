{
  "name": "@feedhorizon/sdk",
  "version": "0.1.0",
  "description": "Official Node.js and TypeScript SDK for the FeedHorizon API: schedule and publish posts on X, LinkedIn, Instagram, Bluesky, Pinterest and TikTok.",
  "license": "MIT",
  "author": "FeedHorizon",
  "homepage": "https://feedhorizon.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bash-bash/feedhorizon-node.git"
  },
  "bugs": "https://github.com/bash-bash/feedhorizon-node/issues",
  "keywords": [
    "feedhorizon",
    "social-media",
    "scheduling",
    "twitter",
    "linkedin",
    "instagram",
    "bluesky",
    "pinterest",
    "tiktok",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "openapi-typescript spec/openapi.json -o src/generated/openapi.ts",
    "spec:update": "curl -fsSL https://feedhorizon.com/openapi.json -o spec/openapi.json && npm run generate",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:generated": "npm run generate && git diff --exit-code src/generated",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
